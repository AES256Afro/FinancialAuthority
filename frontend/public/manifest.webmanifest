{
  "id": "/today",
  "name": "FinancialAuthority",
  "short_name": "Authority",
  "description": "A visual planner for each paycheck, running on your own server.",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f4ef",
  "theme_color": "#141518",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/today", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Cover", "url": "/cover", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Weekly check-in", "url": "/checkin", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
