# Copy to .env. Generate each secret with:  openssl rand -base64 32
FA_USERNAME=owner
FA_PASSWORD=
FA_SESSION_SECRET=
FA_DATA_KEY=
# The https address the app is published at (sets the OAuth issuer for connected clients). Leave empty until published.
FA_PUBLIC_URL=
# Model providers (all optional)
FA_OLLAMA_URL=http://host.docker.internal:11434
FA_ANTHROPIC_API_KEY=
FA_OPENAI_BASE_URL=
FA_OPENAI_API_KEY=
# Load the synthetic household to look around without real data
FA_DEMO=false
TZ=America/Chicago
